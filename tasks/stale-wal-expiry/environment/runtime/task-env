#!/usr/bin/python3
"""Public real Prometheus deployment controls; never used to award rewards."""
import fcntl,json,os,pwd,shutil,signal,subprocess,sys,time,urllib.request
from pathlib import Path
ROOT=Path('/app/task-runtime'); ASSETS=Path('/opt/task-runtime'); SOURCE=Path('/app/prometheus')
PROFILE=(ASSETS/'profile').read_text().strip()
URL='http://127.0.0.1:9090'
def request(path):
    with urllib.request.urlopen(URL+path,timeout=5) as r:return r.read()
def pid(name):
    try:
        n=int((ROOT/(name+'.pid')).read_text()); args=Path(f'/proc/{n}/cmdline').read_bytes()
        if (str(ROOT/'bin/prometheus').encode() if name=='prometheus' else str(ASSETS/'exporters.py').encode()) in args:return n
    except (OSError,ValueError):pass
    return None
def launch(name,args):
    if pid(name):return
    with (ROOT/(name+'.log')).open('ab') as log:
        p=subprocess.Popen(args,stdin=subprocess.DEVNULL,stdout=log,stderr=log,start_new_session=True,close_fds=True)
    (ROOT/(name+'.pid')).write_text(str(p.pid))
def stop():
    for name in ('prometheus','exporters'):
        n=pid(name)
        if n:
            os.kill(n,signal.SIGTERM)
            for _ in range(200):
                if not pid(name):break
                time.sleep(.1)
            else:
                os.kill(n,signal.SIGKILL)
                for _ in range(100):
                    if not pid(name):break
                    time.sleep(.1)
                else:raise RuntimeError(name+' did not exit after SIGKILL')
        (ROOT/(name+'.pid')).unlink(missing_ok=True)
def configure():
    cfg=ROOT/'prometheus.yml'
    if cfg.exists():return
    text='global:\n  scrape_interval: 2s\n  external_labels:\n    cluster: public-demo\nscrape_configs:\n'
    if PROFILE=='scrape-uds-tls':
        subprocess.run(['openssl','req','-x509','-newkey','rsa:2048','-nodes','-keyout',str(ROOT/'key.pem'),'-out',str(ROOT/'cert.pem'),'-days','3650','-subj','/CN=localhost','-addext','subjectAltName=DNS:localhost'],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        for label in ('alpha','beta','secure'):
            text+=f'  - job_name: {label}\n    scheme: '+('https' if label=='secure' else 'http')+'\n'
            if label=='secure':text+=f'    tls_config:\n      ca_file: {ROOT}/cert.pem\n      server_name: localhost\n'
            text+=f'    static_configs:\n      - targets: ["localhost:18080"]\n        labels:\n          __unix_socket__: {ROOT}/{label}.sock\n'
    else:text+='  - job_name: prometheus\n    static_configs:\n      - targets: ["127.0.0.1:9090"]\n'
    cfg.write_text(text)
def seed():
    if (ROOT/'seed.json').exists():return
    end=int(time.time())
    subprocess.run([str(ROOT/'bin/seed'),str(ROOT/'data')],check=True,cwd=SOURCE)
    (ROOT/'seed.json').write_text(json.dumps({'start':end-1800,'end':end,'step':15,'fixed_start':0,'fixed_end':1800})+'\n')
def start():
    configure()
    if PROFILE=='scrape-uds-tls':launch('exporters',['python3',str(ASSETS/'exporters.py')])
    if not pid('prometheus'):
        seed()
        args=[str(ROOT/'bin/prometheus'),'--config.file='+str(ROOT/'prometheus.yml'),'--storage.tsdb.path='+str(ROOT/'data'),'--storage.tsdb.retention.time=100y','--web.listen-address=127.0.0.1:9090','--web.enable-lifecycle','--web.enable-admin-api']
        if PROFILE=='promql-native-histogram':args+=['--enable-feature=promql-extended-range-selectors']
        launch('prometheus',args)
    for _ in range(120):
        if not pid('prometheus'):raise RuntimeError('Prometheus exited: task-env logs')
        try:
            request('/-/ready');print('Real Prometheus ready: '+URL+' profile='+PROFILE);return
        except OSError:time.sleep(.5)
    raise RuntimeError('Prometheus readiness timed out')
def build():
    workspace_sum=SOURCE/'go.work.sum'
    had_workspace_sum=workspace_sum.exists()
    try:
      for name,src in [('prometheus','./cmd/prometheus'),('seed',str(ASSETS/'seed.go')),('storage-demo',str(ASSETS/'storage-demo.go'))]:
          if name=='storage-demo' and not Path(src).exists():continue
          output=str(ROOT/'bin'/name)+'.new'
          builder=ASSETS/'build-storage-demo.sh'
          command=['bash',str(builder),str(SOURCE),output] if name=='storage-demo' and builder.exists() else ['go','build','-o',output,src]
          subprocess.run(command,cwd=SOURCE,check=True,env={**os.environ,'GOWORK':'off'})
    finally:
        if not had_workspace_sum:workspace_sum.unlink(missing_ok=True)
    stop()
    for p in (ROOT/'bin').glob('*.new'):os.replace(p,p.with_suffix(''))
    start()
def main():
    if os.geteuid()==0:
        u=pwd.getpwnam('agent');os.initgroups(u.pw_name,u.pw_gid);os.setgid(u.pw_gid);os.setuid(u.pw_uid);os.environ['HOME']=u.pw_dir
    action=sys.argv[1] if len(sys.argv)>1 else 'help'
    with (ROOT/'control.lock').open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        if action=='start':start()
        elif action=='stop':stop()
        elif action=='restart':stop();start()
        elif action=='rebuild':build()
        elif action=='reset-data':
            stop();shutil.rmtree(ROOT/'data',ignore_errors=True);(ROOT/'seed.json').unlink(missing_ok=True);start()
        elif action=='status':
            if not pid('prometheus'):raise RuntimeError('Prometheus is stopped')
            request('/-/ready');print('ready pid='+str(pid('prometheus'))+' profile='+PROFILE);print((ROOT/'seed.json').read_text());print(request('/api/v1/targets').decode())
        elif action=='logs':
            for p in ROOT.glob('*.log'):print(p);subprocess.run(['tail','-n','50',str(p)],check=True)
        elif action=='storage-demo':
            tool=ROOT/'bin/storage-demo'
            if not tool.exists():raise RuntimeError('This profile has no storage driver')
            dest=sys.argv[2] if len(sys.argv)>2 else str(ROOT/('storage-demo-'+str(time.time_ns())))
            subprocess.run([str(tool),dest],check=True,cwd=SOURCE)
        else:print('task-env start|status|logs|stop|restart|rebuild|reset-data|storage-demo [NEW_DIR]')
if __name__=='__main__':
    try:main()
    except (OSError,RuntimeError,subprocess.CalledProcessError) as e:print(str(e),file=sys.stderr);sys.exit(1)
