#!/usr/bin/python3
"""Public controls for the real VictoriaMetrics development server."""
import fcntl
import json
import os
from pathlib import Path
import pwd
import shutil
import signal
import subprocess
import sys
import time
import urllib.request

ROOT = Path('/app/task-runtime')
SOURCE = Path('/app/victoriametrics')
BINARY = ROOT / 'bin/victoria-metrics'
URL = 'http://127.0.0.1:8428'


def request(path, body=None):
    with urllib.request.urlopen(URL + path, data=body, timeout=5) as response:
        return response.read()


def process():
    try:
        pid = int((ROOT / 'server.pid').read_text())
        args = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
        if args[0] == os.fsencode(BINARY):
            return pid
    except (FileNotFoundError, ValueError, IndexError, ProcessLookupError):
        pass
    return None


def seed():
    if (ROOT / 'seed.json').exists():
        return
    end = int(time.time()) // 60 * 60 - 60
    start = end - 600
    records = []
    # Different hosts and staggered samples model two independently scraped inputs.
    for metric, host, offsets, values in [
        ('demo_requests', 'shared', [0, 60, 180, 300, 480, 600], [10, 12, 16, 20, 25, 30]),
        ('demo_capacity', 'shared', [0, 120, 240, 360, 540, 600], [8, 9, 10, 12, 15, 18]),
        ('demo_requests', 'requests_only', [0, 120, 360, 600], [4, 6, 8, 10]),
        ('demo_capacity', 'capacity_only', [0, 180, 420, 600], [3, 5, 7, 9]),
    ]:
        records.append({'metric': {'__name__': metric, 'host': host}, 'values': values,
                        'timestamps': [(start + offset) * 1000 for offset in offsets]})
    request('/api/v1/import', ('\n'.join(json.dumps(row) for row in records) + '\n').encode())
    request('/internal/force_flush')
    (ROOT / 'seed.json').write_text(json.dumps({'start': start, 'end': end, 'step': 60}) + '\n')
    (ROOT / 'query.env').write_text(f'START={start}\nEND={end}\nSTEP=60\n')


def start():
    if not process():
        with (ROOT / 'server.log').open('ab') as log:
            child = subprocess.Popen([
                str(BINARY), '-httpListenAddr=127.0.0.1:8428',
                f'-storageDataPath={ROOT}/data', '-retentionPeriod=100y',
                '-memory.allowedBytes=256MB', '-search.disableCache',
            ], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True)
        (ROOT / 'server.pid').write_text(str(child.pid))
    for _ in range(120):
        if not process():
            raise RuntimeError(f'Server exited; inspect {ROOT}/server.log')
        try:
            request('/health')
            seed()
            print(f'VictoriaMetrics ready: {URL}; data: {ROOT}/data')
            return
        except OSError:
            time.sleep(0.5)
    raise RuntimeError('Server readiness timed out; inspect server.log')


def stop():
    pid = process()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(100):
            if process() != pid:
                break
            time.sleep(0.1)
        else:
            os.kill(pid, signal.SIGKILL)
            for _ in range(50):
                if process() != pid:
                    break
                time.sleep(0.1)
            else:
                raise RuntimeError('Server did not stop')
    (ROOT / 'server.pid').unlink(missing_ok=True)


def main():
    action = sys.argv[1] if len(sys.argv) == 2 else 'help'
    if os.geteuid() == 0:
        agent = pwd.getpwnam('agent')
        os.initgroups(agent.pw_name, agent.pw_gid)
        os.setgid(agent.pw_gid)
        os.setuid(agent.pw_uid)
        os.environ['HOME'] = agent.pw_dir
    with (ROOT / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == 'start':
            start()
        elif action == 'stop':
            stop()
        elif action == 'restart':
            stop()
            start()
        elif action == 'rebuild':
            # Keep the running server and old binary intact if compilation fails.
            subprocess.run(['go', 'build', '-trimpath', '-buildvcs=false', '-o', str(BINARY) + '.new', './app/victoria-metrics'], cwd=SOURCE, check=True)
            os.replace(str(BINARY) + '.new', BINARY)
            stop()
            start()
        elif action == 'reset-data':
            stop()
            shutil.rmtree(ROOT / 'data', ignore_errors=True)
            (ROOT / 'seed.json').unlink(missing_ok=True)
            (ROOT / 'query.env').unlink(missing_ok=True)
            start()
        elif action == 'status':
            if not process():
                raise RuntimeError('VictoriaMetrics is stopped')
            request('/health')
            print(f'VictoriaMetrics healthy: pid={process()} endpoint={URL}')
            print((ROOT / 'seed.json').read_text().strip())
        elif action == 'logs':
            subprocess.run(['tail', '-n', '100', str(ROOT / 'server.log')], check=True)
        else:
            print('Usage: task-env {start|stop|restart|rebuild|reset-data|status|logs}')
            if action != 'help':
                return 2
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f'task-env: {error}', file=sys.stderr)
        sys.exit(1)
